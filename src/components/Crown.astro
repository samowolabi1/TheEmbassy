---
// The crown from the logo, used as the site's graphic motif.
type Props = {
  width: number;
  height?: number;
  fill?: string;
  /** Add the three jewels on the crown's points. */
  jewels?: boolean;
  /** Add the band under the crown. */
  band?: boolean;
  class?: string;
  style?: string;
  label?: string;
};

const {
  width,
  height = Math.round((width * 20) / 24),
  fill = 'var(--gold)',
  jewels = false,
  band = false,
  class: className,
  style,
  label,
} = Astro.props;
---

<svg
  class={className}
  style={style}
  width={width}
  height={height}
  viewBox="0 0 24 20"
  fill={fill}
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
>
  <path d="M2 16h20l-2-10-5 4-3-7-3 7-5-4z"></path>
  {
    jewels && (
      <>
        <circle cx="2.2" cy="5.5" r="1.4" />
        <circle cx="12" cy="2" r="1.4" />
        <circle cx="21.8" cy="5.5" r="1.4" />
      </>
    )
  }
  {band && <rect x="2" y="17" width="20" height="2" rx="1" />}
</svg>
