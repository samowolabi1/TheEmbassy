---
import Base from '../../layouts/Base.astro';
import Crown from '../../components/Crown.astro';
import PostCard from '../../components/PostCard.astro';
import { featuredPost, posts, topics } from '../../data/posts';

const rest = posts.filter((p) => p !== featuredPost);
---

<Base title="Blog" active="blog" description="Faith, relationships, money, campus and purpose, written by our pastors and members.">
  <section class="container blog-hero stack" style="gap: 36px">
    <div class="section-head">
      <div class="stack" style="gap: 14px; max-width: 720px">
        <span class="eyebrow">THE TRIBE BLOG</span>
        <h1 class="display blog-hero__title">Real talk for <span class="accent-bronze">real life.</span></h1>
      </div>
      <p class="lede" style="max-width: 400px">Faith, relationships, money, campus and purpose, written by our pastors and members.</p>
    </div>

    <a href={`/blog/${featuredPost.slug}`} class="featured bg-navy">
      <div role="img" aria-label="Featured article image placeholder" class="featured__image bg-mid">
        <Crown width={380} height={320} class="crown-bg" style="left: -60px; bottom: -80px; opacity: 0.12" />
        <span class="placeholder__note" style="color: var(--mist)">[Article image]</span>
      </div>
      <div class="featured__body">
        <div class="featured__tags">
          <span class="tag tag--gold">FEATURED</span>
          <span class="tag tag--ghost">{featuredPost.topic}</span>
        </div>
        <span class="featured__title">{featuredPost.title}</span>
        <span class="featured__dek">{featuredPost.dek}</span>
        <span class="featured__by">
          <span class="avatar featured__avatar">{featuredPost.authorInitials}</span>
          <span class="stack">
            <span class="featured__author">{featuredPost.author}</span>
            <span class="featured__meta">{featuredPost.date} · {featuredPost.read}</span>
          </span>
        </span>
      </div>
    </a>
  </section>

  <section class="container section stack" style="gap: 24px" data-filter-scope data-filter-param="topic">
    <div role="tablist" aria-label="Blog topics" class="filters">
      <button type="button" role="tab" class="filter" aria-selected="true" data-filter="all">All topics</button>
      {
        topics.map((t) => (
          <button type="button" role="tab" class="filter" aria-selected="false" data-filter={t}>
            {t}
          </button>
        ))
      }
    </div>
    <div class="grid-auto" style="--min: 320px; --gap: 28px 22px">
      {rest.map((post) => <PostCard post={post} showDek imageHeight={230} data-filter-item data-tag={post.topic} />)}
    </div>
    <p class="lede" data-filter-empty hidden>No articles on this topic yet. Check back soon.</p>
  </section>

  <section class="container section section--last">
    <div class="panel bg-gold pitch">
      <div class="stack" style="gap: 10px; max-width: 560px">
        <span class="pitch__title">Want to write for the blog?</span>
        <span class="pitch__text">We feature stories and lessons from members. Pitch your idea to the media unit.</span>
      </div>
      <a href="#" class="btn btn--navy">Pitch a story</a>
    </div>
  </section>
</Base>

<script>
  import '../../scripts/filters';
</script>

<style>
  .blog-hero {
    padding-top: 72px;
  }
  .blog-hero__title {
    font-size: clamp(42px, 6vw, 84px);
    color: var(--navy);
  }

  .featured {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    border-radius: 36px;
    overflow: hidden;
  }
  .featured:hover {
    color: var(--white);
  }
  .featured__image {
    position: relative;
    overflow: hidden;
    min-height: 420px;
  }
  .featured__body {
    padding: 48px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 18px;
  }
  .featured__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .featured__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1.05;
    letter-spacing: -0.02em;
  }
  .featured__dek {
    font-size: 17px;
    line-height: 1.6;
    color: var(--mist);
  }
  .featured__by {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 6px;
  }
  .featured__avatar {
    width: 44px;
    height: 44px;
    background: var(--gold);
    color: var(--midnight);
    font-size: 14px;
  }
  .featured__author {
    font-weight: 800;
    font-size: 15px;
  }
  .featured__meta {
    font-size: 14px;
    color: var(--mist);
  }

  .pitch {
    border-radius: 36px;
    padding: 52px;
    display: flex;
    flex-wrap: wrap;
    gap: 28px;
    justify-content: space-between;
    align-items: center;
  }
  .pitch__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: clamp(28px, 3.4vw, 42px);
    line-height: 1.05;
  }
  .pitch__text {
    font-size: 17px;
    line-height: 1.55;
    font-weight: 600;
  }

  @media (max-width: 640px) {
    .blog-hero {
      padding-top: 44px;
    }
    .featured__image {
      min-height: 240px;
    }
    .featured__body,
    .pitch {
      padding: 26px;
    }
  }
</style>
