---
import type { GetStaticPaths } from 'astro';
import Base from '../../layouts/Base.astro';
import Crown from '../../components/Crown.astro';
import Icon from '../../components/Icon.astro';
import { posts, type Post } from '../../data/posts';

export const getStaticPaths = (() => posts.map((post) => ({ params: { slug: post.slug }, props: { post } }))) satisfies GetStaticPaths;

type Props = { post: Post };
const { post } = Astro.props;
const related = posts.filter((p) => p !== post).slice(0, 3);
---

<Base title={post.title} active="blog" description={post.dek}>
  <article>
    <header class="article-head">
      <a href="/blog" class="back"><Icon name="chevron-left" size={16} />Back to the blog</a>
      <span class="tag tag--wash">{post.topic}</span>
      <h1 class="display article-head__title">{post.title}</h1>
      <p class="article-head__dek">{post.dek}</p>
      <div class="byline">
        <span class="byline__who">
          <span class="avatar byline__avatar">{post.authorInitials}</span>
          <span class="stack">
            <span class="byline__name">{post.author}</span>
            <span class="byline__meta">{post.date} · {post.read}</span>
          </span>
        </span>
        <span class="share">
          <a href="https://wa.me/" data-share-href="https://wa.me/?text=" class="icon-circle share__btn" aria-label="Share on WhatsApp" target="_blank" rel="noopener"><Icon name="whatsapp" /></a>
          <a href="https://x.com/intent/post" data-share-href="https://x.com/intent/post?text=" class="icon-circle share__btn" aria-label="Share on X" target="_blank" rel="noopener"><Icon name="x" size={18} /></a>
          <button type="button" class="icon-circle share__btn" aria-label="Copy link" data-copy-link><Icon name="link" /></button>
        </span>
      </div>
    </header>

    <div class="article-image-wrap">
      <div role="img" aria-label="Article image placeholder" class="placeholder bg-mid article-image">
        <Crown width={420} height={350} jewels class="crown-bg" style="right: -40px; bottom: -80px; opacity: 0.14" />
        <span class="placeholder__note" style="color: var(--mist)">[Article image]</span>
      </div>
    </div>

    <div class="prose">
      {
        post.body ? (
          post.body.map((block) => {
            if (block.type === 'p') return <p>{block.text}</p>;
            if (block.type === 'h2') return <h2>{block.text}</h2>;
            if (block.type === 'quote')
              return (
                <figure class="scripture">
                  <Crown width={34} height={28} />
                  <blockquote>"{block.text}"</blockquote>
                  <figcaption>{block.cite}</figcaption>
                </figure>
              );
            return (
              <div class="reflect">
                <span class="eyebrow">{block.title}</span>
                <ol>
                  {block.items.map((item) => (
                    <li>{item}</li>
                  ))}
                </ol>
              </div>
            );
          })
        ) : (
          <p>[Article body]</p>
        )
      }
    </div>

    <div class="author-wrap">
      <div class="card author">
        <span class="avatar author__avatar">{post.authorInitials}</span>
        <span class="author__text">
          <span class="author__name">{post.author}</span>
          <span class="author__bio">{post.authorBio}</span>
        </span>
      </div>
    </div>
  </article>

  <section class="container section--tight section--last stack" style="gap: 24px">
    <h2 class="h2 h2--sm">Keep reading</h2>
    <div class="grid-auto" style="--min: 320px; --gap: 22px">
      {
        related.map((p) => (
          <a href={`/blog/${p.slug}`} class="related">
            <div role="img" aria-label="Article image placeholder" class={`related__image bg-${p.swatch}`} />
            <span class="related__topic">{p.topic}</span>
            <span class="related__title">{p.title}</span>
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  // Share links use the live page address, which isn't known at build time.
  const text = encodeURIComponent(`${document.querySelector('h1')?.textContent ?? ''} ${location.href}`);
  for (const a of document.querySelectorAll<HTMLAnchorElement>('[data-share-href]')) {
    a.href = a.dataset.shareHref + text;
  }

  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-copy-link]')) {
    btn.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(location.href);
        btn.setAttribute('aria-label', 'Link copied');
        setTimeout(() => btn.setAttribute('aria-label', 'Copy link'), 2000);
      } catch {
        // Clipboard blocked: leave the button as is.
      }
    });
  }
</script>

<style>
  .article-head {
    max-width: 860px;
    margin: 0 auto;
    padding: 64px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .back {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 800;
    color: var(--bronze);
  }
  .article-head__title {
    font-size: clamp(36px, 5vw, 64px);
    line-height: 1.02;
    color: var(--navy);
  }
  .article-head__dek {
    margin: 0;
    font-size: 20px;
    line-height: 1.55;
    color: var(--slate);
  }
  .byline {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: space-between;
    align-items: center;
    padding: 18px 0;
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }
  .byline__who {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .byline__avatar {
    width: 48px;
    height: 48px;
    background: var(--navy);
    color: var(--gold);
    font-size: 15px;
  }
  .byline__name {
    font-weight: 800;
    font-size: 15px;
    color: var(--navy);
  }
  .byline__meta {
    font-size: 14px;
    color: var(--slate);
  }
  .share {
    display: flex;
    gap: 8px;
  }
  .share__btn {
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--navy);
    cursor: pointer;
    padding: 0;
  }

  .article-image-wrap {
    max-width: 1100px;
    margin: 0 auto;
    padding: 36px 24px 0;
  }
  .article-image {
    height: 480px;
  }

  .prose {
    max-width: 720px;
    margin: 0 auto;
    padding: 48px 24px 0;
    display: flex;
    flex-direction: column;
    gap: 24px;
    font-size: 18px;
    line-height: 1.8;
    color: var(--body);
  }
  .prose p {
    margin: 0;
  }
  .prose h2 {
    margin: 12px 0 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    line-height: 1.15;
    color: var(--navy);
  }
  .scripture {
    margin: 8px 0;
    padding: 28px 30px;
    border-radius: 24px;
    background: var(--navy);
    color: var(--white);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .scripture blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 24px;
    line-height: 1.35;
  }
  .scripture figcaption {
    font-size: 14px;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--gold);
    text-transform: uppercase;
  }
  .reflect {
    margin-top: 8px;
    padding: 26px 28px;
    border-radius: 24px;
    background: var(--wash);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .reflect ol {
    margin: 0;
    padding-left: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    font-size: 17px;
    color: var(--navy);
    font-weight: 600;
  }

  .author-wrap {
    max-width: 720px;
    margin: 0 auto;
    padding: 40px 24px 0;
  }
  .author {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    align-items: center;
    padding: 26px;
  }
  .author__avatar {
    width: 64px;
    height: 64px;
    background: var(--navy);
    color: var(--gold);
    font-size: 18px;
  }
  .author__text {
    flex: 1 1 260px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .author__name {
    font-weight: 800;
    font-size: 17px;
    color: var(--navy);
  }
  .author__bio {
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate);
  }

  .related {
    display: flex;
    flex-direction: column;
    gap: 14px;
    color: var(--ink);
  }
  .related__image {
    height: 200px;
    border-radius: 22px;
  }
  .related__topic {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--bronze);
    text-transform: uppercase;
  }
  .related__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    line-height: 1.2;
    color: var(--navy);
  }

  @media (max-width: 640px) {
    .article-head {
      padding-top: 44px;
    }
    .article-image {
      height: 240px;
    }
  }
</style>
