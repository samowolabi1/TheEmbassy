---
import Base from '../layouts/Base.astro';
import Crown from '../components/Crown.astro';
import Icon from '../components/Icon.astro';
import PostCard from '../components/PostCard.astro';
import { church, config, links } from '../data/site';
import { announcements, declaration, marketItems, testimony } from '../data/home';
import { messages } from '../data/sermons';
import { events } from '../data/events';
import { posts, topics } from '../data/posts';

const latest = messages.filter((m) => m.meta.startsWith('Crowned for More'));
const [headline] = latest;
const sideMessages = [...latest.slice(1), ...messages.filter((m) => m.type === 'podcast')].slice(0, 3);
const homePosts = posts.filter((p) => !p.featured).slice(0, 3);
const homeEvents = events.slice(0, 3);

const socials = [
  { label: 'Instagram', icon: 'instagram', href: links.instagram },
  { label: 'YouTube', icon: 'youtube', href: links.youtube },
  { label: 'TikTok', icon: 'tiktok', href: links.tiktok },
  { label: 'Facebook', icon: 'facebook', href: links.facebook },
  { label: 'X', icon: 'x', href: links.x },
  { label: 'WhatsApp', icon: 'whatsapp', href: links.whatsapp },
] as const;
---

<Base active="home">
  <!-- Hero carousel -->
  <section class="hero on-dark" aria-roledescription="carousel" aria-label="Highlights" data-carousel>
    <div class="container hero__inner">
      <div class="hero__slides">
        <div class="slide" role="group" aria-roledescription="slide" aria-label="1 of 4" data-slide>
          <div class="slide__copy">
            <span class="slide__kicker slide__kicker--outline">RCCG YOUTH CHURCH</span>
            <h1 class="display slide__title">Young. Royal.<br /><span class="accent">Rooted in Christ.</span></h1>
            <p class="slide__text">
              A home for students, creatives and young professionals. Come as you are and grow into who God called you to be.
            </p>
            <div class="slide__ctas">
              <a href="/about#visit" class="btn btn--gold">Plan your visit</a>
              <a href={links.youtube} class="btn btn--outline-light"><Icon name="play" size={16} />Watch on YouTube</a>
            </div>
          </div>
          <div role="img" aria-label="Photo placeholder: Sunday worship" class="placeholder slide__media bg-mid hero__bordered">
            <span class="placeholder__note placeholder__note--right">[Photo: Sunday worship]</span>
            <div class="next-card">
              <span class="next-card__label">NEXT GATHERING</span>
              <span class="next-card__time">Sunday · {church.sundayTime}</span>
              <span class="next-card__where">{church.address}</span>
            </div>
          </div>
        </div>

        <div class="slide" role="group" aria-roledescription="slide" aria-label="2 of 4" data-slide hidden>
          <div class="slide__copy">
            <span class="slide__kicker slide__kicker--gold">SAT 14 NOVEMBER</span>
            <h1 class="display slide__title">Royal Youth<br /><span class="accent">Convention</span></h1>
            <p class="slide__text">Worship, honest conversations and the biggest Tribe hangout of the year. Bring a friend.</p>
            <div class="slide__ctas">
              <a href="/events" class="btn btn--gold">Get your ticket</a>
              <a href="/events" class="btn btn--outline-light">Event details</a>
            </div>
          </div>
          <div role="img" aria-label="Photo placeholder: convention artwork" class="placeholder slide__media bg-gold">
            <Crown width={420} height={350} fill="var(--midnight)" jewels class="crown-bg" style="right: -60px; bottom: -70px; opacity: 0.1" />
            <span class="placeholder__note placeholder__note--right">[Convention flyer]</span>
            <span class="slide__date">14<br /><span>NOV</span></span>
          </div>
        </div>

        <div class="slide" role="group" aria-roledescription="slide" aria-label="3 of 4" data-slide hidden>
          <div class="slide__copy">
            <span class="slide__kicker slide__kicker--outline">NEW SERMON SERIES</span>
            <h1 class="display slide__title">Crowned<br /><span class="accent">for More</span></h1>
            <p class="slide__text">A series on identity, purpose and living as a royal priesthood. New episodes every Sunday.</p>
            <div class="slide__ctas">
              <a href={headline?.url ?? '/watch'} class="btn btn--gold"><Icon name="play" size={16} />Watch week 3</a>
              <a href="/watch" class="btn btn--outline-light">All episodes</a>
            </div>
          </div>
          <div role="img" aria-label="Photo placeholder: series artwork" class="placeholder slide__media bg-night hero__bordered">
            <Crown width={360} height={300} jewels band class="crown-bg slide__crown" style="opacity: 0.9" />
            <span class="placeholder__note placeholder__note--right">[Series artwork]</span>
            <span class="slide__series">CROWNED FOR MORE</span>
          </div>
        </div>

        <div class="slide" role="group" aria-roledescription="slide" aria-label="4 of 4" data-slide hidden>
          <div class="slide__copy">
            <span class="slide__kicker slide__kicker--outline">THIS WEEK'S DECLARATION</span>
            <h1 class="display slide__title">I am chosen.<br />I am royal.<br /><span class="accent">I am His.</span></h1>
            <div class="slide__ctas">
              <a href="#declaration" class="btn btn--gold">Read the full declaration</a>
              <button type="button" class="btn btn--outline-light" data-share data-share-text="I am chosen. I am royal. I am His. 1 Peter 2:9">Share it</button>
            </div>
          </div>
          <div class="slide__media slide__verse">
            <Crown width={64} height={54} jewels />
            <span class="slide__quote">"But you are a chosen people, a royal priesthood, a holy nation, God's special possession."</span>
            <span class="slide__ref">1 PETER 2:9</span>
          </div>
        </div>
      </div>

      <div class="hero__controls">
        <div class="hero__progress">
          <span class="hero__count"><span data-slide-num>01</span> <span class="hero__of">/ 04</span></span>
          <div class="hero__dots">
            {
              [0, 1, 2, 3].map((n) => (
                <button type="button" class="dot" aria-label={`Go to slide ${n + 1}`} aria-current={n === 0 ? 'true' : undefined} data-dot={n}>
                  <span class="dot__fill" />
                </button>
              ))
            }
          </div>
        </div>
        <div class="hero__arrows">
          <button type="button" class="arrow arrow--ghost" aria-label="Previous slide" data-prev><Icon name="chevron-left" /></button>
          <button type="button" class="arrow arrow--solid" aria-label="Next slide" data-next><Icon name="chevron-right" /></button>
          <button type="button" class="hero__pause" data-pause aria-pressed="false">Pause</button>
        </div>
      </div>
    </div>
  </section>

  <!-- Quick links -->
  <section class="container quick">
    <div class="grid-auto" style="--min: 250px; --gap: 14px">
      <a href="/about#visit" class="card quick__item">
        <span class="icon-tile tile-wash"><Icon name="pin" size={24} /></span>
        <span class="quick__text"><span class="quick__title">Plan a visit</span><span class="quick__sub">Service times &amp; directions</span></span>
      </a>
      <a href={links.youtube} class="card quick__item">
        <span class="icon-tile tile-ice"><Icon name="youtube" size={24} /></span>
        <span class="quick__text"><span class="quick__title">Watch on YouTube</span><span class="quick__sub">Live every Sunday</span></span>
      </a>
      <a href="#prayer" class="card quick__item">
        <span class="icon-tile tile-wash"><Icon name="prayer" size={24} /></span>
        <span class="quick__text"><span class="quick__title">Prayer request</span><span class="quick__sub">Our team will pray with you</span></span>
      </a>
      <a href="/give" class="quick__item quick__item--navy">
        <span class="icon-tile tile-gold"><Icon name="heart" size={24} /></span>
        <span class="quick__text"><span class="quick__title">Give online</span><span class="quick__sub">Card, transfer or USSD</span></span>
      </a>
    </div>
  </section>

  <!-- Declaration + announcements -->
  <section id="declaration" class="container section grid-auto" style="--min: 460px">
    <div class="panel bg-gold stack declaration">
      <Crown width={300} height={250} fill="var(--midnight)" class="crown-bg" style="right: -60px; top: -50px; opacity: 0.07" />
      <span class="eyebrow eyebrow--ink">WEEKLY DECLARATION · WEEK OF {declaration.week}</span>
      <h2 class="h2 h2--sm declaration__title">Say it out loud this week.</h2>
      <ol class="declaration__list">
        {
          declaration.lines.map((line, i) => (
            <li>
              <span class="declaration__num">{String(i + 1).padStart(2, '0')}</span>
              {line}
            </li>
          ))
        }
      </ol>
      <button type="button" class="btn btn--navy btn--md declaration__share" data-share data-share-text={declaration.lines.join('\n')}>
        Share the declaration
      </button>
    </div>
    <div class="card panel stack announcements" style="padding: 36px">
      <div class="announcements__head">
        <h2 class="announcements__title">Announcements</h2>
        <a href="#" class="announcements__all">View all</a>
      </div>
      {
        announcements.map((a) => (
          <a href={a.url} class="announcement">
            <span class={`tag tag--${a.tone} announcement__tag`}>{a.tag}</span>
            <span class="announcement__text">
              <span class="announcement__title">{a.title}</span>
              <span class="announcement__body">{a.text}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Latest messages -->
  <section class="container section stack" style="gap: 32px">
    <div class="section-head">
      <div class="stack" style="gap: 12px">
        <span class="eyebrow">WATCH &amp; LISTEN</span>
        <h2 class="h2 h2--lg">Latest messages</h2>
      </div>
      <a href={links.youtube} class="btn btn--youtube btn--md"><Icon name="youtube" />Subscribe on YouTube</a>
    </div>
    <div class="grid-auto" style="--min: 420px; --gap: 24px">
      <a href={headline?.url ?? '/watch'} class="feature-message bg-navy">
        <Crown width={380} height={320} jewels class="crown-bg" style="right: -80px; top: -40px; opacity: 0.12" />
        <span class="tag tag--gold" style="position: relative">NEW SERIES</span>
        <div class="feature-message__body">
          <span class="feature-message__title">Crowned<br /><span class="accent">for More</span></span>
          <span class="feature-message__now">
            <span class="icon-circle feature-message__play"><Icon name="play" /></span>
            <span class="stack">
              <span class="feature-message__name">Week 3: {headline?.title}</span>
              <span class="feature-message__meta">1 Peter 2:9 · {headline?.length} · YouTube</span>
            </span>
          </span>
        </div>
      </a>
      <div class="stack" style="gap: 14px">
        {
          sideMessages.map((m) => (
            <a href={m.url} class="card message-row">
              <div class={`message-row__thumb bg-${m.swatch}`}>
                <Icon name={m.type === 'podcast' ? 'headphones' : 'play'} size={22} />
              </div>
              <span class="stack" style="gap: 4px">
                <span class="message-row__kind">{m.type === 'podcast' ? 'PODCAST' : m.meta.toUpperCase()}</span>
                <span class="message-row__title">{m.title}</span>
                <span class="message-row__len">{m.length}</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- From the blog -->
  <section class="container section stack" style="gap: 28px">
    <div class="section-head">
      <div class="stack" style="gap: 12px">
        <span class="eyebrow">FROM THE BLOG</span>
        <h2 class="h2 h2--lg">Real talk for real life.</h2>
      </div>
      <a href="/blog" class="btn btn--outline btn--md">All articles</a>
    </div>
    <div class="filters">
      <a href="/blog" class="filter topic-link" aria-current="page">All topics</a>
      {topics.map((t) => <a href={`/blog?topic=${encodeURIComponent(t)}`} class="filter topic-link">{t}</a>)}
    </div>
    <div class="grid-auto" style="--min: 320px; --gap: 22px">
      {homePosts.map((post) => <PostCard post={post} />)}
    </div>
  </section>

  <!-- Upcoming events -->
  <section class="container section">
    <div class="events-panel bg-navy on-dark">
      <Crown width={360} height={300} class="crown-bg" style="left: -80px; bottom: -110px; opacity: 0.08" />
      <div class="stack events-panel__copy">
        <span class="eyebrow">UPCOMING EVENTS</span>
        <h2 class="display events-panel__title">Don't miss what's next.</h2>
        <span class="events-panel__text">RSVP in the app and get a reminder before each event.</span>
        <a href="/events" class="btn btn--gold" style="align-self: flex-start; margin-top: 6px">See the calendar</a>
      </div>
      <div class="stack events-panel__list">
        {
          homeEvents.map((e) => (
            <a href={e.url} class:list={['event-row', { 'event-row--gold': e.highlight }]}>
              <span class="date-tile">
                <span class="date-tile__mon">{e.mon}</span>
                <span class="date-tile__day">{e.day}</span>
              </span>
              <span class="stack" style="flex: 1">
                <span class="event-row__title">{e.title}</span>
                <span class="event-row__when">
                  {e.when}
                  {e.highlight && ' · Tickets open'}
                </span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Tribe Market -->
  <section id="market" class="container section stack" style="gap: 32px">
    <div class="section-head">
      <div class="stack" style="gap: 12px; max-width: 640px">
        <span class="eyebrow">TRIBE MARKET</span>
        <h2 class="h2 h2--lg">Shop from the family.</h2>
        <span class="lede">Every order supports a member's business and the work of the church.</span>
      </div>
      <a href="#" class="btn btn--navy btn--md">Visit the market</a>
    </div>
    <div class="grid-auto" style="--min: 230px; --gap: 18px">
      {
        marketItems.map((item) => (
          <a href={item.url} class="product">
            <div role="img" aria-label="Product photo placeholder" class={`product__image bg-${item.swatch}`}>
              <span class="label-chip">{item.category}</span>
            </div>
            <span class="product__row">
              <span class="stack" style="gap: 2px">
                <span class="product__name">{item.name}</span>
                <span class="product__seller">{item.seller}</span>
              </span>
              <span class="product__price">{item.price}</span>
            </span>
          </a>
        ))
      }
    </div>
  </section>

  <!-- Prayer request + testimony -->
  <section id="prayer" class="container section grid-auto" style="--min: 460px">
    <div class="card panel stack prayer" style="padding: 40px">
      <span class="eyebrow">PRAYER REQUEST</span>
      <h2 class="h2 h2--sm">How can we pray with you?</h2>
      <form class="stack prayer__form" data-prayer-form data-endpoint={config.prayerEndpoint}>
        <label class="field">Your name (optional)
          <input type="text" name="name" placeholder="e.g. Tolu" autocomplete="name" />
        </label>
        <label class="field">Phone or email (optional)
          <input type="text" name="contact" placeholder="So a pastor can follow up" />
        </label>
        <label class="field">Your prayer request
          <textarea name="request" required placeholder="Share as much or as little as you like"></textarea>
        </label>
        <label class="prayer__private">
          <input type="checkbox" name="private" />Keep it private: only the pastoral team will see it
        </label>
        <p class="prayer__error" role="alert" hidden data-prayer-error></p>
        <button type="submit" class="btn btn--navy prayer__submit">Send prayer request</button>
      </form>
      <div class="prayer__sent stack" hidden data-prayer-sent tabindex="-1">
        <span class="prayer__sent-title">We've received it. We're praying with you.</span>
        <span class="prayer__sent-text">Someone from our pastoral team will reach out if you left your details.</span>
        <button type="button" class="btn btn--outline btn--sm" style="align-self: flex-start" data-prayer-reset>Send another</button>
      </div>
    </div>
    <figure class="panel bg-navy testimony">
      <Crown width={52} height={44} />
      <blockquote class="testimony__quote">"{testimony.quote}"</blockquote>
      <figcaption class="testimony__who">
        <span class="avatar testimony__avatar">{testimony.initials}</span>
        <span class="stack">
          <span class="testimony__name">{testimony.name}</span>
          <span class="testimony__role">{testimony.role}</span>
        </span>
      </figcaption>
    </figure>
  </section>

  <!-- Give + app -->
  <section id="app" class="container section grid-auto" style="--min: 380px">
    <div class="panel bg-gold stack" style="gap: 16px">
      <span class="eyebrow eyebrow--ink">GIVE</span>
      <h2 class="cta-title">Honour God with your increase.</h2>
      <p class="cta-text cta-text--strong">Tithes, offerings, building fund and missions, by card, bank transfer or USSD.</p>
      <a href="/give" class="btn btn--navy" style="align-self: flex-start; height: 54px; font-size: 15px">Give online</a>
    </div>
    <div class="panel bg-ice stack" style="gap: 16px">
      <span class="eyebrow">THE ROYAL TRIBE APP</span>
      <h2 class="cta-title">Church in your pocket.</h2>
      <p class="cta-text">Watch live, take sermon notes, join the prayer wall, pay your token and shop from members.</p>
      <div class="store-links">
        <a href={links.appStore} class="store-link">App Store</a>
        <a href={links.googlePlay} class="store-link">Google Play</a>
      </div>
    </div>
  </section>

  <!-- Follow -->
  <section class="container section section--last follow">
    <span class="eyebrow">FOLLOW THE TRIBE</span>
    <h2 class="h2 h2--lg">{church.handle} everywhere.</h2>
    <div class="follow__links">
      {
        socials.map((s) => (
          <a href={s.href} class="follow__link">
            <Icon name={s.icon} size={22} />
            {s.label}
          </a>
        ))
      }
    </div>
  </section>
</Base>

<script>
  import { submitJson } from '../scripts/forms';

  // ---- Hero carousel ----
  const carousel = document.querySelector<HTMLElement>('[data-carousel]');
  if (carousel) {
    const slides = [...carousel.querySelectorAll<HTMLElement>('[data-slide]')];
    const dots = [...carousel.querySelectorAll<HTMLButtonElement>('[data-dot]')];
    const num = carousel.querySelector<HTMLElement>('[data-slide-num]');
    const pause = carousel.querySelector<HTMLButtonElement>('[data-pause]');
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let index = 0;
    let timer: number | undefined;
    let paused = reduceMotion;

    const show = (n: number) => {
      index = (n + slides.length) % slides.length;
      slides.forEach((s, i) => (s.hidden = i !== index));
      dots.forEach((d, i) => {
        if (i === index) d.setAttribute('aria-current', 'true');
        else d.removeAttribute('aria-current');
      });
      if (num) num.textContent = String(index + 1).padStart(2, '0');
    };
    const restart = () => {
      window.clearInterval(timer);
      carousel.classList.toggle('is-paused', paused);
      if (!paused) timer = window.setInterval(() => show(index + 1), 6000);
    };
    const go = (n: number) => {
      show(n);
      restart();
    };

    carousel.querySelector('[data-prev]')?.addEventListener('click', () => go(index - 1));
    carousel.querySelector('[data-next]')?.addEventListener('click', () => go(index + 1));
    dots.forEach((d, i) => d.addEventListener('click', () => go(i)));
    pause?.addEventListener('click', () => {
      paused = !paused;
      pause.setAttribute('aria-pressed', String(paused));
      pause.textContent = paused ? 'Play' : 'Pause';
      restart();
    });
    if (pause && paused) {
      pause.setAttribute('aria-pressed', 'true');
      pause.textContent = 'Play';
    }
    // Don't rotate while someone is reading or using the controls.
    carousel.addEventListener('focusin', () => window.clearInterval(timer));
    carousel.addEventListener('focusout', restart);
    restart();
  }

  // ---- Share buttons ----
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-share]')) {
    btn.addEventListener('click', async () => {
      const text = btn.dataset.shareText ?? '';
      const label = btn.textContent;
      try {
        if (navigator.share) {
          await navigator.share({ text, url: location.href });
          return;
        }
        await navigator.clipboard.writeText(`${text}\n${location.href}`);
        btn.textContent = 'Copied';
        setTimeout(() => (btn.textContent = label), 2000);
      } catch {
        // Share sheet dismissed or clipboard blocked: nothing to do.
      }
    });
  }

  // ---- Prayer request ----
  const form = document.querySelector<HTMLFormElement>('[data-prayer-form]');
  const sent = document.querySelector<HTMLElement>('[data-prayer-sent]');
  const error = document.querySelector<HTMLElement>('[data-prayer-error]');
  if (form && sent && error) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const result = await submitJson(form.dataset.endpoint, { ...data, private: data.private === 'on' });
      if (result === 'ok') {
        form.hidden = true;
        error.hidden = true;
        sent.hidden = false;
        sent.focus();
        form.reset();
      } else {
        error.hidden = false;
        error.textContent =
          result === 'unconfigured'
            ? 'Online prayer requests are not switched on yet. Please speak to a pastor on Sunday.'
            : 'Something went wrong sending your request. Please try again.';
      }
    });
    document.querySelector('[data-prayer-reset]')?.addEventListener('click', () => {
      sent.hidden = true;
      form.hidden = false;
      form.querySelector('textarea')?.focus();
    });
  }
</script>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    background: var(--navy);
    color: var(--white);
    overflow: hidden;
  }
  .hero__inner {
    position: relative;
    padding-top: 64px;
    padding-bottom: 140px;
    display: flex;
    flex-direction: column;
    gap: 40px;
  }
  .hero__slides {
    min-height: 500px;
  }
  .slide {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 440px), 1fr));
    gap: 56px;
    align-items: center;
  }
  .slide__copy {
    display: flex;
    flex-direction: column;
    gap: 24px;
    animation: slideIn 0.6s ease both;
  }
  .slide__kicker {
    align-self: flex-start;
    font-size: 13px;
    font-weight: 800;
    letter-spacing: 0.14em;
    padding: 8px 14px;
    border-radius: 999px;
  }
  .slide__kicker--outline {
    color: var(--gold);
    border: 1px solid var(--navy-line);
  }
  .slide__kicker--gold {
    color: var(--midnight);
    background: var(--gold);
  }
  .slide__title {
    font-size: clamp(44px, 5.4vw, 80px);
  }
  .slide__text {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--mist);
    max-width: 500px;
  }
  .slide__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .slide__media {
    height: 480px;
    animation: photoIn 0.7s ease both;
  }
  .hero__bordered {
    border: 1px solid var(--navy-line);
  }
  .bg-gold .placeholder__note {
    color: var(--midnight);
    font-weight: 800;
  }
  .bg-mid .placeholder__note,
  .bg-night .placeholder__note {
    color: var(--mist);
  }
  .next-card {
    position: absolute;
    left: 22px;
    bottom: 22px;
    background: var(--white);
    color: var(--ink);
    border-radius: 20px;
    padding: 16px 20px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
