---
import Base from '../layouts/Base.astro';
import Crown from '../components/Crown.astro';
import Icon from '../components/Icon.astro';
import { church, config } from '../data/site';

const presets = [5000, 10000, 20000, 50000];
const defaultAmount = 10000;
const funds = [
  { id: 'tithe', name: 'Tithe' },
  { id: 'offering', name: 'Offering' },
  { id: 'building', name: 'Building fund' },
  { id: 'missions', name: 'Missions & welfare' },
];
const naira = (n: number) => n.toLocaleString('en-NG');
---

<Base title="Give" description="Give tithes, offerings and to the building fund by card, bank transfer or USSD.">
  <section class="give-hero bg-navy on-dark">
    <Crown width={600} height={500} jewels class="crown-bg" style="left: -200px; bottom: -220px; opacity: 0.08" />
    <div class="container give-hero__inner">
      <div class="stack give-hero__copy">
        <span class="eyebrow">GIVE</span>
        <h1 class="display give-hero__title">Honour God<br /><span class="accent">with your increase.</span></h1>
        <p class="give-hero__text">
          Your giving funds worship, outreach, welfare and the new youth sanctuary. Every gift gets an instant receipt.
        </p>
        <div class="assurances">
          <span><Icon name="lock" size={18} />Secured by Paystack</span>
          <span><Icon name="check" size={18} />Email receipt</span>
        </div>
      </div>

      <form class="give-form" data-give-form data-paystack-key={config.paystackKey} novalidate>
        <fieldset class="segmented">
          <legend class="sr-only">How often</legend>
          <label><input type="radio" name="frequency" value="once" checked /><span>One time</span></label>
          <label><input type="radio" name="frequency" value="monthly" /><span>Monthly</span></label>
        </fieldset>

        <div class="stack" style="gap: 10px">
          <label class="give-label" for="amount">AMOUNT</label>
          <div class="amount">
            <span class="amount__currency" aria-hidden="true">₦</span>
            <input id="amount" name="amount" type="text" inputmode="numeric" autocomplete="off" value={naira(defaultAmount)} aria-describedby="amount-help" data-amount />
          </div>
          <span id="amount-help" class="sr-only">Amount in naira</span>
          <div class="presets" role="group" aria-label="Quick amounts">
            {
              presets.map((v) => (
                <button type="button" class="preset" aria-pressed={v === defaultAmount ? 'true' : 'false'} data-preset={v}>
                  ₦{v / 1000}k
                </button>
              ))
            }
          </div>
        </div>

        <fieldset class="stack funds-wrap">
          <legend class="give-label">GIVE TOWARDS</legend>
          <div class="funds">
            {
              funds.map((f, i) => (
                <label class="fund">
                  <input type="radio" name="fund" value={f.id} checked={i === 0} />
                  <span>{f.name}</span>
                </label>
              ))
            }
          </div>
        </fieldset>

        <label class="field give-email">EMAIL FOR YOUR RECEIPT
          <input type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
        </label>

        <p class="give-error" role="alert" hidden data-give-error></p>
        <button type="submit" class="btn btn--gold give-submit">Give ₦<span data-amount-label>{naira(defaultAmount)}</span><span data-freq-label></span></button>
        <span class="give-note">Card, bank transfer or USSD on the next step</span>
      </form>
    </div>
  </section>

  <section class="container section--tight stack" style="gap: 24px">
    <h2 class="h2">Other ways to give</h2>
    <div class="grid-auto" style="--min: 300px; --gap: 16px">
      <div class="card way">
        <span class="icon-tile" style="background: var(--wash); color: var(--bronze)"><Icon name="bank" size={24} /></span>
        <span class="way__title">Bank transfer</span>
        <span class="stack way__bank">
          <span>{church.bank.name}</span>
          <span class="way__account" data-account>{church.bank.accountNumber}</span>
          <span>{church.bank.accountName}</span>
        </span>
        <button type="button" class="btn btn--outline btn--sm" style="align-self: flex-start" data-copy-account>Copy number</button>
      </div>
      <div class="card way">
        <span class="icon-tile" style="background: var(--ice); color: var(--navy)"><Icon name="phone" size={24} /></span>
        <span class="way__title">USSD</span>
        <span class="way__text">No data? Dial your bank's USSD code and pay with the church's account number above. Use your name as the description.</span>
      </div>
      <div class="way bg-navy">
        <span class="icon-tile" style="background: var(--gold); color: var(--midnight)"><Icon name="heart" size={24} /></span>
        <span class="way__title">In the app</span>
        <span class="way__text" style="color: var(--mist)">Members get a personal account number, giving history and yearly statements in the Royal Tribe app.</span>
        <a href="/#app" class="btn btn--white btn--sm" style="align-self: flex-start">Get the app</a>
      </div>
    </div>
  </section>

  <section class="container section--tight section--last">
    <div class="building bg-gold">
      <div class="stack" style="gap: 14px">
        <span class="eyebrow eyebrow--ink">BUILDING FUND</span>
        <h2 class="h2" style="color: inherit; font-size: clamp(32px, 4vw, 52px)">A new home for the Tribe.</h2>
        <span class="building__text">We're raising funds for a youth sanctuary with space for worship, study and community.</span>
      </div>
      <div class="building__card">
        <div class="building__amounts">
          <span class="building__raised">₦[raised]</span>
          <span class="building__target">of ₦[target]</span>
        </div>
        <div class="progress" role="progressbar" aria-label="Building fund progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="40">
          <div class="progress__bar" style="width: 40%"></div>
        </div>
        <span class="building__givers">[Number] givers so far</span>
        <a href="#amount" class="btn btn--navy btn--md" style="align-self: flex-start" data-pick-fund="building">Give to the building fund</a>
      </div>
    </div>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('[data-give-form]');
  if (form) {
    const amountInput = form.querySelector<HTMLInputElement>('[data-amount]')!;
    const amountLabel = form.querySelector<HTMLElement>('[data-amount-label]')!;
    const freqLabel = form.querySelector<HTMLElement>('[data-freq-label]')!;
    const presets = [...form.querySelectorAll<HTMLButtonElement>('[data-preset]')];
    const error = form.querySelector<HTMLElement>('[data-give-error]')!;

    const parseAmount = () => Number(amountInput.value.replace(/[^\d]/g, '')) || 0;
    const update = () => {
      const amount = parseAmount();
      amountLabel.textContent = amount.toLocaleString('en-NG');
      for (const p of presets) p.setAttribute('aria-pressed', String(Number(p.dataset.preset) === amount));
      const monthly = (form.elements.namedItem('frequency') as RadioNodeList).value === 'monthly';
      freqLabel.textContent = monthly ? ' monthly' : '';
    };

    for (const p of presets) {
      p.addEventListener('click', () => {
        amountInput.value = Number(p.dataset.preset).toLocaleString('en-NG');
        update();
      });
    }
    amountInput.addEventListener('input', () => {
      const amount = parseAmount();
      amountInput.value = amount ? amount.toLocaleString('en-NG') : '';
      update();
    });
    form.addEventListener('change', update);

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      const email = form.querySelector<HTMLInputElement>('input[name="email"]')!;
      let message = '';
      if (parseAmount() < 100) message = 'Please enter an amount of at least ₦100.';
      else if (!email.checkValidity()) message = 'Please enter a valid email so we can send your receipt.';
      else if (!form.dataset.paystackKey)
        message = 'Online giving is not switched on yet. Please use the bank transfer details below for now.';
      // TODO: open Paystack checkout here once PUBLIC_PAYSTACK_KEY is set.
      error.hidden = !message;
      error.textContent = message;
    });

    // "Give to the building fund" preselects that fund and jumps to the form.
    document.querySelector('[data-pick-fund]')?.addEventListener('click', () => {
      const radio = form.querySelector<HTMLInputElement>('input[name="fund"][value="building"]');
      if (radio) radio.checked = true;
    });
  }

  const copy = document.querySelector<HTMLButtonElement>('[data-copy-account]');
  copy?.addEventListener('click', async () => {
    const number = document.querySelector('[data-account]')?.textContent?.trim() ?? '';
    try {
      await navigator.clipboard.writeText(number);
      copy.textContent = 'Copied';
      setTimeout(() => (copy.textContent = 'Copy number'), 2000);
    } catch {
      // Clipboard blocked: the number is still on screen to copy by hand.
    }
  });
</script>

<style>
  .give-hero {
    position: relative;
    overflow: hidden;
  }
  .give-hero__inner {
    position: relative;
    padding-top: 72px;
    padding-bottom: 88px;
    display: flex;
    flex-wrap: wrap;
    gap: 48px;
    align-items: center;
  }
  .give-hero__copy {
    flex: 1 1 420px;
    gap: 20px;
  }
  .give-hero__title {
    font-size: clamp(42px, 5.6vw, 80px);
  }
  .give-hero__text {
    margin: 0;
    font-size: 18px;
    line-height: 1.6;
    color: var(--mist);
    max-width: 480px;
  }
  .assurances {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    font-size: 14px;
    font-weight: 700;
    color: var(--mist);
  }
  .assurances span {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .assurances :global(svg) {
    color: var(--gold);
  }

  .give-form {
    flex: 1 1 420px;
    min-width: 0;
    max-width: 520px;
    background: var(--white);
    color: var(--ink);
    border-radius: 32px;
    padding: 32px;
    display: flex;
    flex-direction: column;
    gap: 20px;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .give-label,
  .give-email {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--slate);
    padding: 0;
  }
  .give-email input {
    letter-spacing: 0;
    height: 52px;
  }

  /* Radio buttons styled as pills; the input stays for keyboard and screen readers */
  .segmented,
  .funds {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  .segmented {
    gap: 4px;
    padding: 4px;
    border-radius: 999px;
    background: var(--sand);
  }
  .segmented input,
  .fund input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }
  .segmented span {
    height: 44px;
    border-radius: 999px;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--slate);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .segmented input:checked + span {
    background: var(--navy);
    color: var(--white);
    font-weight: 800;
  }
  .segmented input:focus-visible + span,
  .fund input:focus-visible + span {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }

  .amount {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 72px;
    padding: 0 20px;
    border-radius: 20px;
    border: 2px solid var(--navy);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 36px;
    color: var(--navy);
  }
  .amount:focus-within {
    outline: 3px solid var(--gold);
    outline-offset: 2px;
  }
  .amount input {
    flex: 1;
    width: 100%;
    min-width: 0;
    border: 0;
    outline: none;
    background: transparent;
    font: inherit;
    color: inherit;
  }
  .presets {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 8px;
  }
  .preset {
    height: 44px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--white);
    color: var(--navy);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .preset[aria-pressed='true'] {
    border-color: var(--gold);
    background: var(--gold);
    color: var(--midnight);
    font-weight: 800;
  }
  .funds-wrap {
    gap: 10px;
  }
  .funds {
    gap: 8px;
    margin-top: 10px;
  }
  .fund span {
    min-height: 52px;
    border-radius: 16px;
    border: 2px solid var(--line);
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0 8px;
    color: var(--navy);
    font-weight: 700;
    font-size: 14px;
    cursor: pointer;
  }
  .fund input:checked + span {
    border-color: var(--gold);
    background: var(--wash);
    font-weight: 800;
  }
  .give-error {
    margin: 0;
    padding: 12px 16px;
    border-radius: 14px;
    background: var(--wash);
    color: var(--navy);
    font-size: 14px;
    font-weight: 600;
  }
  .give-submit {
    height: 58px;
    font-size: 17px;
  }
  .give-note {
    font-size: 13px;
    color: var(--slate);
    text-align: center;
  }

  .way {
    border-radius: 28px;
    padding: 30px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .way__title {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
  }
  .card .way__title {
    color: var(--navy);
  }
  .way__bank {
    gap: 4px;
    font-size: 15px;
    color: var(--body);
  }
  .way__account {
    font-weight: 800;
    font-size: 20px;
    letter-spacing: 0.04em;
    color: var(--navy);
  }
  .way__text {
    font-size: 15px;
    line-height: 1.6;
    color: var(--body);
  }

  .building {
    border-radius: 36px;
    padding: 48px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: 32px;
    align-items: center;
  }
  .building__text {
    font-size: 17px;
    line-height: 1.55;
    font-weight: 600;
  }
  .building__card {
    background: var(--white);
    border-radius: 26px;
    padding: 26px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .building__amounts {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 10px;
  }
  .building__raised {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 30px;
    color: var(--navy);
  }
  .building__target,
  .building__givers {
    font-size: 14px;
    color: var(--slate);
  }
  .building__target {
    font-weight: 700;
  }
  .progress {
    height: 14px;
    border-radius: 999px;
    background: var(--line-soft);
    overflow: hidden;
  }
  .progress__bar {
    height: 100%;
    border-radius: 999px;
    background: var(--navy);
  }

  @media (max-width: 640px) {
    .give-hero__inner {
      padding-top: 44px;
      padding-bottom: 56px;
    }
    .give-form,
    .way,
    .building {
      padding: 24px;
    }
    .amount {
      font-size: 30px;
    }
  }
</style>
