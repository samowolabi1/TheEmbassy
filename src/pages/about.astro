---
import Base from '../layouts/Base.astro';
import Crown from '../components/Crown.astro';
import Icon from '../components/Icon.astro';
import { church, links } from '../data/site';

const values = ['Worship', 'The Word', 'Family', 'Purpose', 'Service'];

const leaders = [
  { name: "[Pastor's name]", role: 'Pastor in Charge', swatch: 'navy' },
  { name: '[Name]', role: 'Assistant Pastor', swatch: 'gold' },
  { name: '[Name]', role: 'Youth Pastor', swatch: 'ice' },
  { name: '[Name]', role: 'Coordinator, Units', swatch: 'mid' },
];

const beliefs = [
  'The Bible is the inspired Word of God.',
  'One God: Father, Son and Holy Spirit.',
  'Salvation is by grace through faith in Jesus.',
  'A life of holiness, empowered by the Holy Spirit.',
  'Water baptism and Holy Communion.',
  'The return of Jesus Christ.',
];

const units = [
  { name: 'Choir', text: 'Lead the Tribe in worship every Sunday and at special services.' },
  { name: 'Media & tech', text: 'Livestream, sound, lights, photography and social media.' },
  { name: 'Ushering & welcome', text: 'Be the first smile people see and help first-timers feel at home.' },
  { name: 'Drama & creative arts', text: 'Tell the gospel through drama, spoken word, dance and design.' },
  { name: 'Prayer', text: 'Stand in the gap for the church and pray over every request.' },
  { name: 'Outreach & welfare', text: 'Take the love of Christ to campuses, streets and families in need.' },
];

const faqs = [
  { q: 'What should I wear?', a: 'Come as you are. Most people dress smart casual, and nobody will judge your outfit.' },
  { q: 'How long is the service?', a: 'Sunday service runs for about [length]. Stay after for refreshments and to meet the Tribe.' },
  { q: 'Is there parking?', a: '[Parking details]. Our ushers will guide you when you arrive.' },
  { q: 'I am new to church. Will I fit in?', a: 'Yes. Many of us came for the first time not knowing anyone. Our welcome team will introduce you around.' },
  { q: 'Can I watch online first?', a: 'Absolutely. We stream every Sunday on YouTube and in the Royal Tribe app.' },
];
---

<Base title="About" active="about" description="Who we are, what we believe and how to plan your first visit to The Royal Tribe Embassy.">
  <section class="page-hero bg-navy on-dark">
    <Crown width={560} height={470} jewels class="crown-bg" style="right: -120px; bottom: -150px; opacity: 0.08" />
    <div class="container page-hero__inner">
      <span class="eyebrow">ABOUT US</span>
      <h1 class="display page-hero__title">A royal tribe, raising a generation for Christ.</h1>
      <p class="page-hero__text">
        The Royal Tribe Embassy is a youth parish of The Redeemed Christian Church of God, built for students, creatives and young professionals.
      </p>
    </div>
  </section>

  <section class="container section grid-auto story" style="--min: 440px; --gap: 48px">
    <div class="stack" style="gap: 18px">
      <span class="eyebrow">OUR STORY</span>
      <h2 class="h2">Church that feels like family.</h2>
      <p class="body-copy">[Your story: when the parish started, who started it and why. Two or three short paragraphs work best.]</p>
      <p class="body-copy">
        Today we gather every Sunday to worship, learn the Word and build friendships that last beyond the service. Whether you are in school, starting a career or building a business, there is a place for you here.
      </p>
    </div>
    <div role="img" aria-label="Photo placeholder: congregation" class="placeholder bg-ice story__photo">
      <span class="placeholder__note">[Photo: the Tribe together]</span>
      <div class="story__badge"><Crown width={36} height={30} fill="var(--midnight)" /></div>
    </div>
  </section>

  <section class="container section grid-auto" style="--min: 340px">
    <div class="pillar bg-navy">
      <span class="eyebrow eyebrow--gold">OUR MISSION</span>
      <span class="pillar__text">To help young people know Christ, grow in Him and live out their royal calling.</span>
    </div>
    <div class="pillar bg-gold">
      <span class="eyebrow eyebrow--ink">OUR VISION</span>
      <span class="pillar__text">A generation of believers who lead with excellence in every sphere of life.</span>
    </div>
    <div class="pillar card">
      <span class="eyebrow">OUR VALUES</span>
      <ul class="values">
        {values.map((v, i) => <li class={i % 2 ? 'bg-ice' : 'bg-wash'}>{v}</li>)}
      </ul>
    </div>
  </section>

  <section class="container section stack" style="gap: 32px">
    <div class="stack" style="gap: 12px; max-width: 680px">
      <span class="eyebrow">LEADERSHIP</span>
      <h2 class="h2">Meet our pastors.</h2>
    </div>
    <div class="grid-auto" style="--min: 260px">
      {
        leaders.map((l) => (
          <div class="stack" style="gap: 14px">
            <div role="img" aria-label={`Photo placeholder: ${l.role}`} class={`leader__photo bg-${l.swatch}`}>
              <span class="leader__note">[Photo]</span>
            </div>
            <span class="stack" style="gap: 2px">
              <span class="leader__name">{l.name}</span>
              <span class="leader__role">{l.role}</span>
            </span>
          </div>
        ))
      }
    </div>
  </section>

  <section class="container section">
    <div class="card beliefs">
      <div class="stack" style="gap: 14px">
        <span class="eyebrow">WHAT WE BELIEVE</span>
        <h2 class="h2" style="font-size: clamp(30px, 3.6vw, 44px)">Rooted in the Word.</h2>
        <p class="beliefs__text">
          We hold the beliefs of The Redeemed Christian Church of God. Read the full statement of faith on the RCCG website.
        </p>
        <a href={links.rccgBeliefs} class="btn btn--outline btn--sm" style="align-self: flex-start; height: 48px">Read the full statement</a>
      </div>
      <ul class="beliefs__list">
        {
          beliefs.map((b) => (
            <li>
              <Crown width={20} height={20} class="beliefs__icon" />
              {b}
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section id="units" class="container section stack" style="gap: 32px">
    <div class="section-head">
      <div class="stack" style="gap: 12px; max-width: 640px">
        <span class="eyebrow">UNITS</span>
        <h2 class="h2">Every gift has a place.</h2>
      </div>
      <a href="/#app" class="btn btn--navy btn--md">Join a unit in the app</a>
    </div>
    <div class="grid-auto" style="--min: 270px; --gap: 14px">
      {
        units.map((u) => (
          <div class="card unit">
            <span class="unit__name">{u.name}</span>
            <span class="unit__text">{u.text}</span>
          </div>
        ))
      }
    </div>
  </section>

  <section id="visit" class="container section section--last grid-auto visit" style="--min: 460px; --gap: 24px">
    <div class="stack" style="gap: 20px">
      <span class="eyebrow">PLAN YOUR VISIT</span>
      <h2 class="h2">We saved you a seat.</h2>
      <div role="img" aria-label="Map placeholder" class="placeholder bg-ice visit__map">
        <span class="placeholder__note">[Map]</span>
        <span class="visit__pin"></span>
      </div>
      <div class="grid-auto" style="--min: 200px; --gap: 12px">
        <div class="card visit__fact">
          <span class="visit__label">ADDRESS</span>
          <span class="visit__value">{church.address}</span>
        </div>
        <div class="card visit__fact">
          <span class="visit__label">SUNDAYS</span>
          <span class="visit__value">{church.sundayTime}</span>
        </div>
      </div>
      <a href={church.directionsUrl} class="btn btn--gold" style="align-self: flex-start; height: 54px; font-size: 15px">Get directions</a>
    </div>
    <div class="stack" style="gap: 12px">
      <h3 class="faq__heading">Questions first-timers ask</h3>
      {
        faqs.map((f, i) => (
          <details class="card faq" open={i === 0}>
            <summary>
              {f.q}
              <span class="faq__icon faq__icon--plus"><Icon name="plus" /></span>
              <span class="faq__icon faq__icon--minus"><Icon name="minus" /></span>
            </summary>
            <p>{f.a}</p>
          </details>
        ))
      }
    </div>
  </section>
</Base>

<style>
  .page-hero {
    position: relative;
    overflow: hidden;
  }
  .page-hero__inner {
    position: relative;
    padding-top: 88px;
    padding-bottom: 96px;
    display: flex;
    flex-direction: column;
    gap: 22px;
  }
  .page-hero__title {
    font-size: clamp(42px, 6vw, 88px);
    max-width: 900px;
  }
  .page-hero__text {
    margin: 0;
    font-size: 19px;
    line-height: 1.6;
    color: var(--mist);
    max-width: 620px;
  }

  .story {
    align-items: center;
  }
  .body-copy {
    margin: 0;
    font-size: 17px;
    line-height: 1.7;
    color: var(--body);
  }
  .story__photo {
    height: 460px;
  }
  .story__badge {
    position: absolute;
    right: 22px;
    bottom: 22px;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    background: var(--gold);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pillar {
    border-radius: 28px;
    padding: 36px;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .pillar__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 26px;
    line-height: 1.25;
  }
  .values {
    margin: 0;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .values li {
    font-weight: 800;
    font-size: 15px;
    padding: 9px 14px;
    border-radius: 999px;
  }

  .leader__photo {
    position: relative;
    height: 320px;
    border-radius: 28px;
  }
  .leader__note {
    position: absolute;
    left: 18px;
    bottom: 18px;
    font-size: 13px;
    font-weight: 700;
    opacity: 0.85;
  }
  .bg-navy .leader__note,
  .bg-mid .leader__note {
    color: var(--mist);
  }
  .leader__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 22px;
    color: var(--navy);
  }
  .leader__role {
    font-size: 15px;
    color: var(--bronze);
    font-weight: 700;
  }

  .beliefs {
    border-radius: 36px;
    padding: 52px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr));
    gap: 40px;
  }
  .beliefs__text {
    margin: 0;
    font-size: 16px;
    line-height: 1.7;
    color: var(--slate);
  }
  .beliefs__list {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 14px;
    align-content: start;
  }
  .beliefs__list li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
    font-size: 15px;
    line-height: 1.55;
    color: var(--body);
  }
  .beliefs__list :global(.beliefs__icon) {
    flex-shrink: 0;
    margin-top: 2px;
  }

  .unit {
    padding: 24px;
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .unit__name {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 21px;
    color: var(--navy);
  }
  .unit__text {
    font-size: 15px;
    line-height: 1.55;
    color: var(--slate);
  }

  .visit {
    align-items: start;
  }
  .visit__map {
    height: 300px;
    border-radius: 28px;
  }
  .visit__map .placeholder__note {
    color: var(--navy);
  }
  .visit__pin {
    position: absolute;
    left: 50%;
    top: 50%;
    margin: -26px 0 0 -20px;
    width: 40px;
    height: 40px;
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--gold);
    border: 3px solid var(--navy);
  }
  .visit__fact {
    border-radius: 20px;
    padding: 18px;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .visit__label {
    font-size: 12px;
    font-weight: 800;
    letter-spacing: 0.1em;
    color: var(--bronze);
  }
  .visit__value {
    font-weight: 700;
    font-size: 15px;
    color: var(--navy);
  }

  .faq__heading {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 24px;
    color: var(--navy);
    padding: 8px 0;
  }
  .faq {
    border-radius: 20px;
    overflow: hidden;
  }
  .faq summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 64px;
    padding: 14px 20px;
    font-weight: 800;
    font-size: 16px;
    color: var(--navy);
    cursor: pointer;
  }
  .faq summary::-webkit-details-marker {
    display: none;
  }
  .faq__icon {
    display: flex;
    flex-shrink: 0;
    color: var(--bronze);
  }
  .faq__icon--minus,
  .faq[open] .faq__icon--plus {
    display: none;
  }
  .faq[open] .faq__icon--minus {
    display: flex;
  }
  .faq p {
    margin: 0;
    padding: 0 20px 20px;
    font-size: 15px;
    line-height: 1.65;
    color: var(--slate);
  }

  @media (max-width: 640px) {
    .page-hero__inner {
      padding-top: 44px;
      padding-bottom: 56px;
    }
    .story__photo {
      height: 280px;
    }
    .pillar,
    .beliefs {
      padding: 26px;
    }
  }
</style>
